#!/bin/sh
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd)
if ! command -v pwsh >/dev/null 2>&1; then
  if [ -r "$dir/clm-text.sh" ]; then . "$dir/clm-text.sh"; fi
  type clm_text >/dev/null 2>&1 || clm_text() { printf '%s
' "$2"; }
  CLM_LANG_DIR="$dir/lang"
  clm_text install.launcher.needPwsh "clm needs PowerShell 7 (the pwsh command), which was not found in the PATH." >&2
  clm_text install.launcher.macHint "macOS: brew install powershell" >&2
  clm_text install.launcher.linuxHint "Linux: https://learn.microsoft.com/powershell/scripting/install/linux-overview" >&2
  exit 127
fi
exec pwsh -NoProfile -File "$dir/claude-menu.ps1" "$@"
